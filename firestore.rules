rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents ────────────────────────────────────────────────────────
    // Each user can only read/write their own top-level document and sub-collections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Pro entitlement fields — deny client writes even to their own doc.
      // These decide subscription access; only the backend (Admin SDK, which
      // bypasses these rules entirely) may set them, via /api/iap/verify or
      // /api/admin/codes/redeem after real server-side verification. Without
      // this, any signed-in user could write their own proExpiresAt directly
      // via the Firestore SDK and grant themselves free access.
      match /data/profile {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && !request.resource.data.keys().hasAny(['proExpiresAt', 'proSource']);
        allow update: if request.auth != null && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proExpiresAt', 'proSource']);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // All other synced docs (users/{uid}/data/*). Deliberately NOT a
      // recursive {document=**} wildcard: Firestore ORs every matching rule,
      // so a wildcard here would re-allow writes to data/profile and defeat
      // the proExpiresAt/proSource protection above.
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && docId != 'profile';
      }
    }

    // ── Feedback collection ───────────────────────────────────────────────────
    // feedback and analytics: the app sends both through the backend
    // (Supabase / Admin SDK), never straight to Firestore, so client access
    // is closed by the deny-all below. These used to allow any signed-in
    // client (anonymous included) to create documents with no rate limit.

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
